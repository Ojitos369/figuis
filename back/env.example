# ----------------------   DB (docker compose)   ----------------------
# Valores para levantar todo con `docker compose up -d` (servicio figuis-dbp,
# red interna). El 5472 es solo el puerto expuesto al host.
# Si corres el back suelto en el host (uvicorn) contra el contenedor de dev
# figuis-dbl (ver tables/init.sql), usa en tu .env local:
#   DB_HOST=localhost  DB_PORT=5442
DB_NAME="figuis"
DB_USER="figuis"
DB_PASSWORD="figuis"
DB_HOST="figuis-dbp"
DB_PORT="5432"
EMAIL_HOST="your_smtp_host"
EMAIL_HOST_USER="your_email_user"
EMAIL_HOST_PASSWORD="your_email_password"
RUN_PROD_MODE="False"
RUN_DEV_MODE="True"
PUBLIC_BASE_URL="https://figuis.ojitos3695.com"
HOME_PREVIEW_CAPTURE_URL="https://figuis.ojitos3695.com/?social_capture=1"
HOME_PREVIEW_REFRESH_SECONDS="3600"
# Sin límite: panel admin de un solo usuario, las subidas van en streaming a
# disco (nunca se bufferean en memoria). Poner un entero en bytes reintroduce
# el tope si hiciera falta.
MAX_REQUEST_BODY_SIZE="unlimited"
MAX_UPLOAD_FILE_SIZE="unlimited"
# Política separada de OAI-SearchBot/Googlebot, que siempre pueden rastrear lo público.
ALLOW_AI_TRAINING_CRAWLERS="False"
# Agrega aquí cualquier hostname/origen adicional que termine TLS delante de /mcp.
MCP_ALLOWED_HOSTS="figuis.ojitos3695.com"
MCP_ALLOWED_ORIGINS="https://figuis.ojitos3695.com"
