# ----------------------   DB (docker compose)   ----------------------
# Valores para levantar todo con `docker compose up -d` (servicio figuis-dbp,
# red interna). El 5472 es solo el puerto expuesto al host.
# Si corres el back suelto en el host (uvicorn) contra el contenedor de dev
# figuis-dbl (ver tables/init.sql), usa en tu .env local:
#   DB_HOST=localhost  DB_PORT=5442
DB_NAME="figuis"
DB_USER="figuis"
DB_PASSWORD="figuis"
DB_HOST="figuis-dbp"
DB_PORT="5432"
EMAIL_HOST="your_smtp_host"
EMAIL_HOST_USER="your_email_user"
EMAIL_HOST_PASSWORD="your_email_password"
RUN_PROD_MODE="False"
RUN_DEV_MODE="True"
PUBLIC_BASE_URL="https://figuis.ojitos3695.com"
